class Solution {
    public int romanToInt(String s) {
        int c=0;
          Map<Character, Integer> rom = new HashMap<>();
          rom.put('I',1);
          rom.put('V',5);
          rom.put('X',10);
          rom.put('L',50); 
          rom.put('C',100);
          rom.put('D',500);
          rom.put('M',1000);
          for (int i = 0; i < s.length(); i++) {
          char c1= s.charAt(i);
          int v=rom.get(c1);
          if(i+1<s.length() && v<rom.get(s.charAt(i+1))){
            c-=v;
         }
         else{
            c+=v;
         }
         }
  return c;
    }
}
