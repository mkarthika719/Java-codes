class Solution {
    public boolean isIsomorphic(String s, String t) {
        int n=s.length();
        for(int i=0;i<n;i++){
            char c=s.charAt(i);
            char d=t.charAt(i);
            for(int j=i;j<n;j++){
                if(s.charAt(j)!=c && t.charAt(j)==d){
                    return false;
                }
                if(s.charAt(j)==c && t.charAt(j)!=d){
                    return false;
                }
            }
        }
        return true;
    }
}
